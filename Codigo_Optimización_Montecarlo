import numpy as np
import pandas as pd
import scipy.stats as stats
import matplotlib.pyplot as plt
import seaborn as sns

excel_path = "Base de Datos Duraciones de Cirugias.xlsx"
xls = pd.ExcelFile(excel_path)
df_raw = pd.read_excel(excel_path, sheet_name="Datos")

tipos_validos = [
    "Osteosíntesis de Tibia",
    "Artroplastia Total de Rodilla",
    "Artroplastia Total de Cadera",
    "Reconstrucción LCA (Artroscopia)"
]

df_cir = df_raw[df_raw["Tipo de Cirugía"].isin(tipos_validos)].copy()
df_real = df_cir[df_cir["Estado Cirugía"] == "Realizada"].copy()

for col in [
    "Tiempo Pre-Quirúrgico (min)",
    "Tiempo Cirugía (min)",
    "Tiempo Post-Quirúrgico / Salida (min)",
    "Tiempo Total Ocupación Sala (min)"
]:
    df_real[col] = pd.to_numeric(df_real[col], errors="coerce")

perfiles_cirugia = {}
for proc in tipos_validos:
    sub = df_real[df_real["Tipo de Cirugía"] == proc]
    t_cir = sub["Tiempo Cirugía (min)"].dropna().astype(float)
    t_pre = sub["Tiempo Pre-Quirúrgico (min)"].dropna().astype(float)
    t_post = sub["Tiempo Post-Quirúrgico / Salida (min)"].dropna().astype(float)

    if proc == "Osteosíntesis de Tibia":
        shape_w, _, scale_w = stats.weibull_min.fit(t_cir, floc=0)
        p75_cir = stats.weibull_min.ppf(0.75, c=shape_w, scale=scale_w)
        perfiles_cirugia[proc] = {
            "dist": "weibull", "param1": shape_w, "param2": scale_w,
            "p75_cir": p75_cir,
            "pre_mean": t_pre.mean(), "pre_sd": t_pre.std(ddof=1),
            "post_mean": t_post.mean(), "post_sd": t_post.std(ddof=1),
            "prioridad_base": 1
        }
    elif proc == "Artroplastia Total de Rodilla":
        sd_ln, _, scale_ln = stats.lognorm.fit(t_cir, floc=0)
        p75_cir = stats.lognorm.ppf(0.75, s=sd_ln, scale=scale_ln)
        perfiles_cirugia[proc] = {
            "dist": "lognorm", "param1": np.log(scale_ln), "param2": sd_ln,
            "p75_cir": p75_cir,
            "pre_mean": t_pre.mean(), "pre_sd": t_pre.std(ddof=1),
            "post_mean": t_post.mean(), "post_sd": t_post.std(ddof=1),
            "prioridad_base": 2
        }
    elif proc == "Artroplastia Total de Cadera":
        mu_n, sd_n = stats.norm.fit(t_cir)
        p75_cir = stats.norm.ppf(0.75, loc=mu_n, scale=sd_n)
        perfiles_cirugia[proc] = {
            "dist": "norm", "param1": mu_n, "param2": sd_n,
            "p75_cir": p75_cir,
            "pre_mean": t_pre.mean(), "pre_sd": t_pre.std(ddof=1),
            "post_mean": t_post.mean(), "post_sd": t_post.std(ddof=1),
            "prioridad_base": 2
        }
    else:
        mu_n, sd_n = stats.norm.fit(t_cir)
        p75_cir = stats.norm.ppf(0.75, loc=mu_n, scale=sd_n)
        perfiles_cirugia[proc] = {
            "dist": "norm", "param1": mu_n, "param2": sd_n,
            "p75_cir": p75_cir,
            "pre_mean": t_pre.mean(), "pre_sd": t_pre.std(ddof=1),
            "post_mean": t_post.mean(), "post_sd": t_post.std(ddof=1),
            "prioridad_base": 3
        }

def generar_tiempos_aleatorios(rng, proc, factor_recambio=1.0, factor_cirugia=1.0):
    pf = perfiles_cirugia[proc]
    t_pre = max(5.0, rng.normal(pf["pre_mean"], pf["pre_sd"]) * factor_recambio)

    if pf["dist"] == "weibull":
        t_cir = rng.weibull(pf["param1"]) * pf["param2"]
    elif pf["dist"] == "lognorm":
        t_cir = rng.lognormal(mean=pf["param1"], sigma=pf["param2"])
    else:
        t_cir = max(10.0, rng.normal(loc=pf["param1"], scale=pf["param2"]))

    t_cir *= factor_cirugia
    t_post_sala = max(5.0, rng.normal(pf["post_mean"], pf["post_sd"]) * factor_recambio)
    t_urpa = max(30.0, rng.normal(pf["post_mean"] * 2.5, pf["post_sd"] * 1.5))
    return t_pre, t_cir, t_post_sala, t_urpa


def duracion_robusta_p75(proc):
    pf = perfiles_cirugia[proc]
    return pf["pre_mean"] + pf["p75_cir"] + pf["post_mean"]

df_muestra = pd.concat([
    df_cir[df_cir["Estado Cirugía"] == "Suspendida"].head(5),
    df_real.sample(5, random_state=42)
]).reset_index(drop=True)

lista_cirugias = []
for _, row in df_muestra.iterrows():
    proc = row["Tipo de Cirugía"]
    prio = 1 if row["Estado Cirugía"] == "Suspendida" else perfiles_cirugia[proc]["prioridad_base"]
    lista_cirugias.append((row["ID Cirugía"], proc, prio))

secuencia_programada = sorted(
    lista_cirugias,
    key=lambda x: (x[2], -duracion_robusta_p75(x[1]))
)

def simular_escenario_mc(
    n_iter=5000,
    n_salas=2,
    jornada_min=480,
    tope_sobretiempo=60,
    cap_urpa=2,
    factor_recambio=1.0,
    factor_cirugia=1.0,
    seed=42
):
    rng = np.random.default_rng(seed)
    sobretiempos_prom = []
    ociosos_prom = []
    cumplimiento_pct = []
    bloqueos_urpa_pct = []

    for _ in range(n_iter):
        reloj_salas = np.zeros(n_salas)
        egresos_urpa = []
        completadas = 0
        hubo_bloqueo_urpa = 0

        for _, proc, _ in secuencia_programada:
            t_pre, t_cir, t_post_sala, t_urpa = generar_tiempos_aleatorios(
                rng, proc, factor_recambio=factor_recambio, factor_cirugia=factor_cirugia
            )
            ocupacion_sala = t_pre + t_cir + t_post_sala

            sala_idx = int(np.argmin(reloj_salas))
            hora_inicio = reloj_salas[sala_idx]
            hora_fin = hora_inicio + ocupacion_sala

            if hora_inicio > jornada_min + tope_sobretiempo:
                continue

            egresos_urpa = [t for t in egresos_urpa if t > hora_fin]
            if len(egresos_urpa) >= cap_urpa:
                hubo_bloqueo_urpa = 1
                continue

            reloj_salas[sala_idx] = hora_fin
            completadas += 1
            egresos_urpa.append(hora_fin + t_urpa)

        sobre = np.maximum(0.0, reloj_salas - jornada_min)
        ocio = np.maximum(0.0, jornada_min - reloj_salas)

        sobretiempos_prom.append(np.mean(sobre))
        ociosos_prom.append(np.mean(ocio))
        cumplimiento_pct.append((completadas / len(secuencia_programada)) * 100.0)
        bloqueos_urpa_pct.append(hubo_bloqueo_urpa * 100.0)

    return {
        "Sobretiempo_Prom_min": round(float(np.mean(sobretiempos_prom)), 2),
        "Sobretiempo_P90_min": round(float(np.percentile(sobretiempos_prom, 90)), 2),
        "Ocio_Prom_min": round(float(np.mean(ociosos_prom)), 2),
        "Cumplimiento_Pct": round(float(np.mean(cumplimiento_pct)), 2),
        "Prob_Bloqueo_URPA_Pct": round(float(np.mean(bloqueos_urpa_pct)), 2)
    }

escenarios = {
    "E1: Base (480 min, Recambio 100%, URPA=2)": simular_escenario_mc(factor_recambio=1.0, jornada_min=480, cap_urpa=2),
    "E2: Recambio Optimizado (-20% Pre/Post)": simular_escenario_mc(factor_recambio=0.80, jornada_min=480, cap_urpa=2),
    "E3: Recambio (-20%) + Jornada 510 min": simular_escenario_mc(factor_recambio=0.80, jornada_min=510, cap_urpa=2),
    "E4: Estrés Variabilidad (+15% Cirugía)": simular_escenario_mc(factor_recambio=1.0, jornada_min=480, cap_urpa=2, factor_cirugia=1.15)
}

df_res = pd.DataFrame(escenarios).T
print(df_res.to_string())

plt.close("all")
sns.set_theme(style="whitegrid")

fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))
etiquetas = ["E1: Base", "E2: Recambio -20%", "E3: Recambio +510m", "E4: Estrés +15%"]
colores = ["#4C72B0", "#2CA02C", "#1F77B4", "#D62728"]

axes[0].bar(etiquetas, df_res["Sobretiempo_Prom_min"], color=colores)
axes[0].set_title("Sobretiempo Promedio (min)")
axes[0].set_ylabel("Minutos")
axes[0].tick_params(axis="x", rotation=18)

axes[1].bar(etiquetas, df_res["Cumplimiento_Pct"], color=colores)
axes[1].set_title("Cumplimiento Agenda (%)")
axes[1].set_ylabel("Porcentaje (%)")
axes[1].set_ylim(0, 105)
axes[1].tick_params(axis="x", rotation=18)

axes[2].bar(etiquetas, df_res["Prob_Bloqueo_URPA_Pct"], color=colores)
axes[2].set_title("Prob. Bloqueo URPA (%)")
axes[2].set_ylabel("Porcentaje (%)")
axes[2].set_ylim(0, max(df_res["Prob_Bloqueo_URPA_Pct"].max() * 1.25, 10))
axes[2].tick_params(axis="x", rotation=18)

plt.tight_layout()
plt.savefig("simulacion_monte_carlo_recalibrada.png", dpi=300, bbox_inches="tight")
plt.show()
